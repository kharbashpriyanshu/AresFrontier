# Ares Frontier - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ares_frontier
USE_IN_MEMORY_FALLBACK=true

# NASA Open APIs
NASA_API_KEY=DEMO_KEY
NASA_API_BASE_URL=https://api.nasa.gov

# External AI/ML Microservice (Person 3)
ML_SERVICE_URL=http://localhost:8000
ENABLE_ML_SERVICE=false
ML_SERVICE_TIMEOUT_MS=3000

# Science Rules Service (Person 4)
SCIENCE_SERVICE_URL=http://localhost:8001
ENABLE_SCIENCE_SERVICE=false
SCIENCE_SERVICE_TIMEOUT_MS=3000

# Security & Auth (Person 2)
JWT_SECRET=super-secret-martian-mission-key-change-in-prod
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
